# projecT87 — environment template (dummy values; copy to .env, never commit real .env)
# Multi-tenant autonomous DeFi service (FastAPI + Web3) on Arbitrum.
# Vendored into bot-nation as a native local service. Deploys separately (e.g. Render);
# bot-nation-api reaches it via PROJECT87_API_URL / PROJECT87_API_KEY (see bot-nation .dev.vars.example).

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
APP_SECRET_KEY=replace_me_random_string
NETWORK_MODE=testnet            # testnet | mainnet
REPLIT_DEPLOYMENT=0

# ── RPC endpoints (Arbitrum) ─────────────────────────────────────────────────
ARBITRUM_RPC_URL=https://arb-mainnet.example/replace_me
ALCHEMY_ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/REPLACE_ME
ALCHEMY_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/REPLACE_ME
ARB_RPC_URL=https://arb-mainnet.example/replace_me
RPC_URL=https://arb-mainnet.example/replace_me
TENDERLY_RPC_URL=https://arb.gateway.tenderly.co/REPLACE_ME

# ── Wallet & signing keys  ⚠️ SECRETS — never commit real values ──────────────
BOT_PRIVATE_KEY=0xREPLACE_ME_64_HEX
DEPLOYER_PRIVATE_KEY=0xREPLACE_ME_64_HEX
PRIVATE_KEY=0xREPLACE_ME_64_HEX
PRIVATE_KEY2=0xREPLACE_ME_64_HEX
BOT_WALLET_ADDRESS=0xREPLACE_ME_ADDRESS
TARGET_WALLET_ADDRESS=0xREPLACE_ME_ADDRESS
WALLET_B_ADDRESS=0xREPLACE_ME_ADDRESS
WALLET_S_ADDRESS=0xREPLACE_ME_ADDRESS

# ── Contract addresses (Arbitrum) ────────────────────────────────────────────
OPENCLAW_VAULT_ADDRESS=0xREPLACE_ME_ADDRESS
DELEGATION_MANAGER_ADDRESS=0xREPLACE_ME_ADDRESS

# ── External API keys  ⚠️ SECRETS ────────────────────────────────────────────
PERPLEXITY_API_KEY=replace_me
COINMARKETCAP_API_KEY=replace_me
COINAPI_KEY=replace_me
COIN_API_KEY=replace_me
SCRAPER_API_KEY=replace_me
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── Strategy thresholds / tuning (non-secret) ────────────────────────────────
TARGET_HEALTH_FACTOR=1.05
ARB_TO_DAI_THRESHOLD=0
DAI_TO_ARB_THRESHOLD=0
BTC_DROP_THRESHOLD=0
ARB_RSI_OVERBOUGHT=70
ARB_RSI_OVERSOLD=30
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9
MINIMUM_CONFIDENCE_THRESHOLD=0.6
AUTO_SUPPLY_COOLDOWN_SECONDS=300
MARKET_SIGNAL_ENABLED=0
PATTERN_CONFIRMATION_REQUIRED=1
MULTI_VALIDATION_REQUIRED=1

# ── Real-estate / Google (optional module; NOT WIRED to bot-nation) ──────────
COURT_LOOKUP_ENABLED=0
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=replace_me_or_path
GOOGLE_REVIEW_TEMPLATE_ID=replace_me
