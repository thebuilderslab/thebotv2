{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-nation-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pbot-nation-db",
      "database_id": "53800135-51c4-459f-837e-2606b4431762",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_ACTOR",
        "class_name": "AgentActor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AgentActor"]
    }
  ],
  "triggers": {
    "crons": [
      // ══════════════════════════════════════════════════════════════════════
      // Only Schwab + finance crons ACTIVE; all other components paused.
      // (Quiz bot retired/archived 2026-07-29 — see _archived/quiz-bot/.)
      // ══════════════════════════════════════════════════════════════════════
      // ── ACTIVE: Schwab + finance ──────────────────────────────────────────
      "*/5 * * * *",          // task dispatcher — REQUIRED engine for finance tasks to execute
      "0 */6 * * *",          // Schwab token heartbeat (no LLM — works regardless of OpenRouter)
      "*/5 13-20 * * 1-5",    // market-hours position stream (TWS position ticks)
      "30 12 * * 1-5",        // morning trading brief (agent-finance-lead)
      "30 13 * * 1-5",        // daily price targets
      "30 18 * * 1-5",        // midday trading analysis
      "0 19 * * 1-5",         // position exit monitor — 3pm ET pre-close
      "30 20 * * 1-5",        // EOD trading wrap-up
      "35 20 * * 1-5",        // trade decision quality metrics (programmatic)
      "0 12 * * 1-5",         // A.12 daily finance-intel progress report
      "0 0 * * 1",            // weekly trade planning session (Sun 8pm ET)
      "0 13 * * 1"           // OpenRouter weekly balance report (Mon 9am ET)
      // ── PAUSED (non-finance) — uncomment to restore ───────────────────────
      // "15 12 * * *",            // daily intel check
      // "0 15 * * *",             // daily research digest
      // "0 12 * * 1",             // weekly intel brief
      // "0 12 * * 3",             // weekly skill refinement
      // "0 6,10,14,18,22,2 * * *",// supervisor 4-hour reminders (ops digest)
      // "0 4 * * 2",              // weekly YouTube market intelligence
      // "0 1 * * 1",              // weekly Telegram quality review
      // "0 2 * * 1",              // weekly mission & directives review
      // "40 3 1 5 *"              // dead one-time R16 verification (past)
    ]
  },
  "limits": { "cpu_ms": 300000 },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Set this to your SearXNG instance URL after deploying to Railway/Render/Fly.io.
    // No API key needed — SearXNG is self-hosted and open.
    // Example: "https://my-searxng.up.railway.app"
    "SEARXNG_BASE_URL": "https://thebotv2-t0ik.onrender.com",
    "LAST30DAYS_URL": "https://last30days-api.onrender.com",
    "HERMES_API_URL": "https://hermes-api-minimal.onrender.com",
    "AUTORESEARCHCLAW_URL": "https://autoresearchclaw-api.onrender.com",
    "TRADING_URL": "https://tradingagents-api-q747.onrender.com",
    // projecT87 native DeFi service — deploy separately, then set this URL.
    // API key is a secret: `wrangler secret put PROJECT87_API_KEY`. Empty = NOT WIRED.
    "PROJECT87_API_URL": "",
    // thinkorswim integration — set TWS_API_KEY as a wrangler secret
    "TWS_WEBHOOK_SECRET": ""
  }
}